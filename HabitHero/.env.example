# Habit Hero Environment Variables

# App Configuration
APP_NAME=Habit Hero
APP_ENV=development

# Feature Flags
ENABLE_ANIMATIONS=true
ENABLE_HAPTICS=true
ENABLE_SOUNDS=true
ENABLE_CONFETTI=true

# Analytics (Optional - for future use)
# ANALYTICS_ENABLED=false
# ANALYTICS_API_KEY=

# Debugging
DEBUG_MODE=true
